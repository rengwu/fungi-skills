        "html": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>\n*{box-sizing:border-box}body{margin:0;background:#faf9f6;color:#292b31;font:14px system-ui,-apple-system,sans-serif}header{padding:18px 20px 12px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}h1{font-size:19px;margin:0 0 4px}small{color:#686b76;font-size:12px}.switch{display:flex;padding:3px;background:#eae8e3;border-radius:9px;gap:3px}button{font:inherit;cursor:pointer}.switch button{border:0;border-radius:6px;background:transparent;color:#5f626d;padding:8px 12px;font-size:12px}.switch button[aria-pressed=true]{background:#fff;color:#33244d;box-shadow:0 1px 3px #0002}button:focus-visible{outline:3px solid #8971b2;outline-offset:3px}.viewport{overflow-x:auto;margin:0 14px;border:1px solid #e1ded8;border-radius:12px;background-color:#f3f2ee;background-image:radial-gradient(#d4d2cb .7px,transparent .7px);background-size:16px 16px}.stage{position:relative;width:720px;min-width:720px;height:345px;margin:0 auto}.view{position:absolute;inset:0}.view[hidden]{display:none}.lines{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.lines path{stroke:#bfb6cc;stroke-width:2;fill:none}.column{position:absolute;top:24px;width:190px}.column:nth-of-type(1){left:32px}.column:nth-of-type(2){left:265px}.column:nth-of-type(3){left:498px}.column h2{font-size:12px;color:#77717e;letter-spacing:.04em;margin:0 0 16px}.lesson{position:relative;margin:0 0 18px;padding:11px 12px;border:1px solid #d6d1de;border-radius:9px;background:#fff;box-shadow:0 2px 4px #34244307;font-size:12px}.lesson:before{content:'';display:inline-block;height:6px;width:6px;background:#8f7aa9;border-radius:50%;margin-right:9px;vertical-align:1px}.lesson:not(:last-child):after{content:'';position:absolute;top:100%;left:24px;height:19px;border-left:1px solid #bfb6cc}.group{position:absolute;top:70px;width:186px;padding:17px 16px;background:#fff;border:1px solid #d6d1de;border-radius:12px;box-shadow:0 3px 10px #34244309;text-align:left;color:#292b31}.group[data-cluster=foundations]{left:34px}.group[data-cluster=practice]{left:267px;top:105px}.group[data-cluster=projects]{left:500px}.group[aria-pressed=true]{border-color:#8f72b0;box-shadow:0 0 0 2px #dcd3e6}.group strong{font-size:15px;display:block;margin-bottom:7px}.dots{display:flex;gap:5px;margin-top:14px}.dots i{width:7px;height:7px;border-radius:50%;background:#b6a8c9}.detail{position:absolute;left:34px;right:34px;bottom:24px;padding:15px 17px;background:#fffffff2;border:1px solid #e1ded8;border-radius:11px}.detail strong{font-size:12px;color:#6e5a88}.detail ul{display:flex;gap:7px;list-style:none;margin:11px 0 0;padding:0}.detail li{font-size:11px;padding:7px 9px;border:1px solid #e5dfee;border-radius:6px;flex:1;background:#fbf9fd}.caption{padding:12px 20px 16px;line-height:1.5;font-size:12px;color:#666973;min-height:52px}\n</style></head><body>\n<header><div><h1>Library</h1><small>12 sample lessons · illustrative design</small></div><div class=\"switch\" role=\"group\" aria-label=\"Canvas variant\"><button type=\"button\" data-variant=\"dense\" aria-pressed=\"true\">Label-dense</button><button type=\"button\" data-variant=\"clusters\" aria-pressed=\"false\">Cluster-first</button></div></header>\n<div class=\"viewport\" aria-label=\"Scrollable library canvas\"><div class=\"stage\">\n<section class=\"view\" id=\"dense\" aria-label=\"Label-dense canvas\"><svg class=\"lines\" viewBox=\"0 0 720 345\" aria-hidden=\"true\"><path d=\"M222 80 C245 80 242 140 265 140 M455 200 C480 200 475 80 498 80\"/></svg><div class=\"column\"><h2>FOUNDATIONS</h2><div class=\"lesson\">Read a graph</div><div class=\"lesson\">Trace a chain</div><div class=\"lesson\">Compare paths</div><div class=\"lesson\">Connect ideas</div></div><div class=\"column\"><h2>PRACTICE</h2><div class=\"lesson\">Recall the steps</div><div class=\"lesson\">Spot a pattern</div><div class=\"lesson\">Choose a route</div><div class=\"lesson\">Explain a link</div></div><div class=\"column\"><h2>PROJECTS</h2><div class=\"lesson\">Plan a sequence</div><div class=\"lesson\">Build a small map</div><div class=\"lesson\">Review the links</div><div class=\"lesson\">Share the result</div></div></section>\n<section class=\"view\" id=\"clusters\" aria-label=\"Cluster-first canvas\" hidden><svg class=\"lines\" viewBox=\"0 0 720 345\" aria-hidden=\"true\"><path d=\"M220 117 C245 117 243 152 267 152 M453 152 C478 152 475 117 500 117\"/></svg><button type=\"button\" class=\"group\" data-cluster=\"foundations\" aria-pressed=\"true\"><strong>Foundations</strong><small>4 lessons</small><span class=\"dots\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i></span></button><button type=\"button\" class=\"group\" data-cluster=\"practice\" aria-pressed=\"false\"><strong>Practice</strong><small>4 lessons</small><span class=\"dots\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i></span></button><button type=\"button\" class=\"group\" data-cluster=\"projects\" aria-pressed=\"false\"><strong>Projects</strong><small>4 lessons</small><span class=\"dots\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i></span></button><div class=\"detail\" aria-live=\"polite\"><strong id=\"detail-title\">Foundations</strong><ul id=\"detail-lessons\"></ul></div></section>\n</div></div><div class=\"caption\" id=\"caption\" aria-live=\"polite\"></div>\n<script>\nconst data={foundations:{title:'Foundations',lessons:['Read a graph','Trace a chain','Compare paths','Connect ideas']},practice:{title:'Practice',lessons:['Recall the steps','Spot a pattern','Choose a route','Explain a link']},projects:{title:'Projects',lessons:['Plan a sequence','Build a small map','Review the links','Share the result']}};\nconst initial=window.grill&&window.grill.state||{};\nlet state={variant:initial.variant==='clusters'?'clusters':'dense',cluster:Object.hasOwn(data,initial.cluster)?initial.cluster:'foundations'};\nfunction draw(){document.querySelectorAll('[data-variant]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.variant===state.variant)));document.querySelector('#dense').hidden=state.variant!=='dense';document.querySelector('#clusters').hidden=state.variant!=='clusters';document.querySelectorAll('[data-cluster]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.cluster===state.cluster)));const current=data[state.cluster];document.querySelector('#detail-title').textContent=current.title;document.querySelector('#detail-lessons').replaceChildren(...current.lessons.map(title=>{const li=document.createElement('li');li.textContent=title;return li}));document.querySelector('#caption').textContent=state.variant==='dense'?'Every lesson title is visible across the library. Scroll horizontally on narrow screens.':'The library opens as topic groups. Select a group to inspect its lessons. Scroll horizontally on narrow screens.';}\nfunction update(change){state={...state,...change};if(window.grill)window.grill.setState({...state});draw();}\ndocument.querySelectorAll('[data-variant]').forEach(button=>button.addEventListener('click',()=>update({variant:button.dataset.variant})));\ndocument.querySelectorAll('[data-cluster]').forEach(button=>button.addEventListener('click',()=>update({cluster:button.dataset.cluster})));\ndraw();\n</script></body></html>",
